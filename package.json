{
  "name": "ai-compiler-demo",
  "version": "0.1.0",
  "private": true,
  "description": "A modular pipeline for converting product prompts into strict app configuration and runtime-aware output.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "evaluate": "ts-node src/evaluator.ts",
    "check": "tsc --noEmit",
    "prestart": "npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.14.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
